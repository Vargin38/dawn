{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
{%- comment -%}
  Ürün bilgi kutuları ve hızlı işlemler.
  Garanti: makine ve cihazlarda 2 yıl (mağaza sahibi, 2026-09-30). Sarf malzemelerinde (bez, lastik) gösterilmez.
  Menşei yalnızca doğrulanmış markalar için yazılır; bilinmeyen markada satır hiç çıkmaz.
{%- endcomment -%}
{%- liquid
  assign marka = product.vendor | downcase
  assign tur = product.type | downcase
  assign garanti = false
  if tur contains 'cihaz' or tur contains 'makine' or tur contains 'instrument' or tur contains 'machine'
    assign garanti = true
  endif
  assign mensei = ''
  case marka
    when 'kett', 'newlong'
      assign mensei = 'Japonya'
      if dg_en
        assign mensei = 'Japan'
      endif
    when 'hawo'
      assign mensei = 'Almanya'
      if dg_en
        assign mensei = 'Germany'
      endif
  endcase
  assign kat = nil
  assign kat_sayi = 100000
  for c in product.collections
    if c.handle != 'frontpage' and c.all_products_count < kat_sayi
      assign kat = c
      assign kat_sayi = c.all_products_count
    endif
  endfor
  assign pdf = ''
  if product.description contains 'class="urun-katalog"'
    assign kutu = product.description | split: 'class="urun-katalog"' | last
    assign yol = kutu | split: 'href="https://cdn.shopify.com' | last | split: '"' | first
    assign pdf = 'https://cdn.shopify.com' | append: yol
  endif
-%}
<dl class="dg-bilgi">
  <div><dt>{% if dg_en %}Brand{% else %}Marka{% endif %}</dt><dd>{{ product.vendor }}</dd></div>
  {%- if kat -%}<div><dt>{% if dg_en %}Category{% else %}Kategori{% endif %}</dt><dd><a href="{{ kat.url }}">{{ kat.title }}</a></dd></div>{%- endif -%}
  {%- if garanti -%}<div><dt>{% if dg_en %}Warranty{% else %}Garanti{% endif %}</dt><dd>{% if dg_en %}2 years{% else %}2 yıl{% endif %}</dd></div>{%- endif -%}
  {%- if mensei != '' -%}<div><dt>{% if dg_en %}Origin{% else %}Menşei{% endif %}</dt><dd>{{ mensei }}</dd></div>{%- endif -%}
  <div><dt>{% if dg_en %}Stock{% else %}Stok{% endif %}</dt><dd>{%- if product.available -%}<span class="dg-bilgi__var">{% if dg_en %}In stock{% else %}Stokta{% endif %}</span>{%- else -%}{% if dg_en %}By quotation{% else %}Teklif ile{% endif %}{%- endif -%}</dd></div>
</dl>
<ul class="dg-hizli">
  {%- if pdf != '' -%}
    <li><a href="{{ pdf }}" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'belge' %}<span>{% if dg_en %}Product document{% else %}Ürün belgesi{% endif %}</span></a></li>
  {%- endif -%}
  <li><a href="tel:+905418890092">{% render 'dg-ikon', ad: 'tel' %}<span>{% if dg_en %}Call us{% else %}Bizi arayın{% endif %}</span></a></li>
  <li><button type="button" onclick="window.print()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 8V3h10v5"/><rect x="3" y="8" width="18" height="9" rx="1"/><path d="M7 14h10v7H7z"/></svg><span>{% if dg_en %}Print{% else %}Yazdır{% endif %}</span></button></li>
</ul>
<style>
  .dg-bilgi { display: flex; flex-wrap: wrap; margin: 2.4rem 0 0; border-top: 1px solid var(--dg-cizgi); border-left: 1px solid var(--dg-cizgi); }
  .dg-bilgi > div { flex: 1 1 13rem; min-width: 0; padding: 1.2rem 1.4rem; border-right: 1px solid var(--dg-cizgi); border-bottom: 1px solid var(--dg-cizgi); background: #fff; }
  .dg-bilgi dt { font-family: var(--dg-mono); font-size: 1.1rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--dg-soluk); }
  .dg-bilgi dd { margin: .4rem 0 0; font-size: 1.45rem; font-weight: 600; line-height: 1.35; color: var(--dg-lac); }
  .dg-bilgi dd a { color: var(--dg-etkin); text-underline-offset: .3rem; }
  .dg-bilgi__var { color: #1F7A3E; }
  .dg-hizli { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: .8rem; margin: 1.2rem 0 0; padding: 0; }
  .dg-hizli li { display: flex; }
  .dg-hizli a, .dg-hizli button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem; width: 100%; padding: 1.2rem .6rem; border: 1px solid var(--dg-cizgi); border-radius: 2px; background: #fff; color: var(--dg-lac); font: 600 1.25rem/1.3 var(--dg-body); text-align: center; text-decoration: none; cursor: pointer; transition: border-color .2s, color .2s; }
  .dg-hizli a:hover, .dg-hizli button:hover { border-color: var(--dg-etkin); color: var(--dg-etkin); }
  .dg-hizli a:focus-visible, .dg-hizli button:focus-visible { outline: 2px solid var(--dg-etkin); outline-offset: 2px; }
  .dg-hizli svg { width: 2.2rem; height: 2.2rem; color: var(--dg-etkin); }
  @media print {
    .dg-hizli, .dg-mobil-bar, .product-form, .dg-urun-cta, .dg-satis-not, .quote-request, .dg-alternatif, .header-wrapper, .footer, .announcement-bar-section { display: none !important; }
  }
</style>
