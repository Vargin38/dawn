{%- liquid
  assign marka = product.vendor | downcase
  assign pdf = ''
  if product.description contains 'class="urun-katalog"'
    assign kutu = product.description | split: 'class="urun-katalog"' | last
    assign yol = kutu | split: 'href="https://cdn.shopify.com' | last | split: '"' | first
    assign pdf = 'https://cdn.shopify.com' | append: yol
    assign paragraflar = kutu | split: '<p>'
    assign boyut = paragraflar[1] | split: '(PDF, ' | last | split: ')' | first | strip_html | strip
  endif
  assign satista = false
  if product.tags contains 'Satışta'
    assign satista = true
  endif
  assign basvuru_wa = 'Merhaba, online sipariş için firma hesabı açmak istiyorum.' | url_encode | replace: '+', '%20'
-%}
{%- capture dg_izin -%}{%- render 'dg-satis', product: product -%}{%- endcapture -%}
{%- if dg_izin contains 'evet' -%}
  <p class="dg-satis-not">{% render 'dg-ikon', ad: 'kalkan' %}<span>Kredi/banka kartı veya havale/EFT ile ödeme</span></p>
  <div class="dg-urun-cta dg-urun-cta--ikincil">
    <a href="#teklif-formu" class="dg-btn dg-btn--koyu-cizgi">Toplu alım için teklif</a>
    <a href="{% render 'dg-urun-wa', product: product %}" class="dg-btn dg-btn--wa dg-guven__wa" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'wa' %}WhatsApp</a>
  </div>
{%- else -%}
  <div class="dg-urun-cta">
    <a href="#teklif-formu" class="dg-btn dg-btn--mavi dg-urun-cta__ana">Teklif İste{% render 'dg-ikon', ad: 'ok' %}</a>
    <a href="{% render 'dg-urun-wa', product: product %}" class="dg-btn dg-btn--wa dg-guven__wa" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'wa' %}WhatsApp</a>
  </div>
  {%- comment -%} "Satışta" etiketli ama fiyatı henüz girilmemiş ürünler için kısa not. {%- endcomment -%}
  {%- if satista -%}
    <div class="dg-uye-kutu">
      <strong>Bu ürünün fiyatı henüz yayımlanmadı</strong>
      <p>Güncel fiyat, teslim süresi ve ödeme koşulları için teklif isteyin; genellikle 24 saat içinde dönüyoruz.</p>
    </div>
  {%- endif -%}
{%- endif -%}
<ul class="dg-urun-notlar">
  <li>{% render 'dg-ikon', ad: 'saat' %}<span>{% if dg_izin contains 'evet' %}Toplu alım ve proje fiyatı için teklifimizi genellikle 24 saat içinde iletiriz.{% else %}Fiyat ve teslim süresi firmanıza özel teklifle, genellikle 24 saat içinde iletilir.{% endif %}</span></li>
  {%- if pdf != '' -%}
    <li>{% render 'dg-ikon', ad: 'indir' %}<span><a href="{{ pdf }}" target="_blank" rel="noopener">Ürün kataloğunu indirin</a> <span class="dg-urun-notlar__boyut">PDF · {{ boyut }}</span></span></li>
  {%- endif -%}
  {%- if marka == 'kett' or marka == 'hawo' -%}
    <li>{% render 'dg-ikon', ad: 'kalkan' %}<span>{{ product.vendor }} Türkiye distribütöründen; kurulum, servis ve yedek parça desteğiyle.</span></li>
  {%- elsif marka == 'euromesh' -%}
    <li>{% render 'dg-ikon', ad: 'belge' %}<span>Uygulamanızı yazın, doğru kodu katalog değerleriyle birlikte seçelim.</span></li>
  {%- else -%}
    <li>{% render 'dg-ikon', ad: 'kurulum' %}<span>Servis ve yedek parça desteğiyle.</span></li>
  {%- endif -%}
</ul>
