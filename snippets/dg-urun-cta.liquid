{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
{%- liquid
  assign marka = product.vendor | downcase
  assign pdf = ''
  if product.description contains 'class="urun-katalog"'
    assign kutu = product.description | split: 'class="urun-katalog"' | last
    assign yol = kutu | split: 'href="https://cdn.shopify.com' | last | split: '"' | first
    assign pdf = 'https://cdn.shopify.com' | append: yol
    assign paragraflar = kutu | split: '<p>'
    assign boyut = paragraflar[1] | split: '(PDF, ' | last | split: ')' | first | strip_html | strip
  endif
  assign satista = false
  if product.tags contains 'Satışta'
    assign satista = true
  endif
  assign basvuru_wa = 'Merhaba, online sipariş için firma hesabı açmak istiyorum.' | url_encode | replace: '+', '%20'
  if dg_en
    assign basvuru_wa = 'Hello, I would like to open a business account for online orders.' | url_encode | replace: '+', '%20'
  endif
-%}
{%- capture dg_izin -%}{%- render 'dg-satis', product: product -%}{%- endcapture -%}
{%- if dg_izin contains 'evet' -%}
  <div class="dg-urun-cta dg-urun-cta--ikincil">
    <a href="#teklif-formu" class="dg-btn dg-btn--koyu-cizgi">{% if dg_en %}Quote for bulk orders{% else %}Toplu alım için teklif{% endif %}</a>
    <a href="{% render 'dg-urun-wa', product: product %}" class="dg-btn dg-btn--wa dg-guven__wa" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'wa' %}WhatsApp</a>
  </div>
{%- else -%}
  <div class="dg-urun-cta">
    <a href="#teklif-formu" class="dg-btn dg-btn--mavi dg-urun-cta__ana">{% if dg_en %}Request a quote{% else %}Teklif İste{% endif %}{% render 'dg-ikon', ad: 'ok' %}</a>
    <a href="{% render 'dg-urun-wa', product: product %}" class="dg-btn dg-btn--wa dg-guven__wa" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'wa' %}WhatsApp</a>
  </div>
  {%- comment -%} "Satışta" etiketli ama fiyatı henüz girilmemiş ürünler için kısa not. {%- endcomment -%}
  {%- if satista -%}
    <div class="dg-uye-kutu">
      <strong>{% if dg_en %}The price of this product has not been published yet{% else %}Bu ürünün fiyatı henüz yayımlanmadı{% endif %}</strong>
      <p>{% if dg_en %}Request a quote for the current price, delivery time and payment terms; we usually reply within 24 hours.{% else %}Güncel fiyat, teslim süresi ve ödeme koşulları için teklif isteyin; genellikle 24 saat içinde dönüyoruz.{% endif %}</p>
    </div>
  {%- endif -%}
{%- endif -%}
<ul class="dg-urun-notlar">
  <li>{% render 'dg-ikon', ad: 'saat' %}<span>{% if dg_izin contains 'evet' %}{% if dg_en %}For bulk and project pricing, we usually send our quote within 24 hours.{% else %}Toplu alım ve proje fiyatı için teklifimizi genellikle 24 saat içinde iletiriz.{% endif %}{% else %}{% if dg_en %}Price and delivery time are sent in a quote tailored to your company, usually within 24 hours.{% else %}Fiyat ve teslim süresi firmanıza özel teklifle, genellikle 24 saat içinde iletilir.{% endif %}{% endif %}</span></li>
  {%- if pdf != '' -%}
    <li>{% render 'dg-ikon', ad: 'indir' %}<span><a href="{{ pdf }}" target="_blank" rel="noopener">{% if dg_en %}Download the product catalogue{% else %}Ürün kataloğunu indirin{% endif %}</a> <span class="dg-urun-notlar__boyut">PDF · {{ boyut }}</span></span></li>
  {%- endif -%}
  {%- if marka == 'kett' or marka == 'hawo' -%}
    <li>{% render 'dg-ikon', ad: 'kalkan' %}<span>{% if dg_en %}From the {{ product.vendor }} distributor in Türkiye, with installation, service and spare parts support.{% else %}{{ product.vendor }} Türkiye distribütöründen; kurulum, servis ve yedek parça desteğiyle.{% endif %}</span></li>
  {%- elsif marka == 'euromesh' -%}
    <li>{% render 'dg-ikon', ad: 'belge' %}<span>{% if dg_en %}Tell us your application and we will choose the right code with its catalogue values.{% else %}Uygulamanızı yazın, doğru kodu katalog değerleriyle birlikte seçelim.{% endif %}</span></li>
  {%- else -%}
    <li>{% render 'dg-ikon', ad: 'kurulum' %}<span>{% if dg_en %}With service and spare parts support.{% else %}Servis ve yedek parça desteğiyle.{% endif %}</span></li>
  {%- endif -%}
</ul>
