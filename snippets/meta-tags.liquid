{%- liquid
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description
  if og_description == blank
    assign og_description = settings.dg_meta_aciklama | default: shop.name
  endif

  # Paylaşım görseli: sayfanın kendi görseli yoksa tema ayarındaki görsel, o da yoksa logo.
  assign dg_paylasim_gorsel = page_image | default: settings.dg_og_gorsel | default: settings.logo

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | strip_newlines | truncate: 200 | escape }}">

{%- if dg_paylasim_gorsel != blank -%}
  {%- assign dg_og_url = dg_paylasim_gorsel | image_url: width: 1200 -%}
  <meta property="og:image" content="https:{{ dg_og_url }}">
  <meta property="og:image:secure_url" content="https:{{ dg_og_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: dg_paylasim_gorsel.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ dg_paylasim_gorsel.alt | default: shop.name | escape }}">
  <meta name="twitter:image" content="https:{{ dg_og_url }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | strip_newlines | truncate: 200 | escape }}">

<meta name="theme-color" content="#0B2239">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
