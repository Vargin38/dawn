        "ss-tab-3": { "type": "tab", "settings": { "tab": "Teklif ve fiyat" } },
        "ss-faq_item-4": { "type": "faq_item", "settings": { "question": "Fiyatlar neden sitede görünmüyor?", "answer": "<p>Fiyatlar; sipariş adedi, teslimat yeri ve güncel tedarik koşullarına göre değiştiği için her talebe özel teklif hazırlıyoruz.</p>" } },
        "ss-faq_item-5": { "type": "faq_item", "settings": { "question": "Nasıl teklif alabilirim?", "answer": "<p>İlgilendiğiniz ürünün sayfasındaki <strong>Teklif İste</strong> butonuna tıklayıp formu doldurun. Katalogda yer almayan ürünler için <a href=\"/pages/contact\">iletişim sayfasındaki</a> formu kullanabilirsiniz.</p>" } },
        "ss-faq_item-6": { "type": "faq_item", "settings": { "question": "Teklife ne kadar sürede dönüş yapıyorsunuz?", "answer": "<p>Talepleri hafta içi 09:00–18:00 arasında yanıtlıyoruz; genellikle 24 saat içinde dönüş yapıyoruz.</p>" } },
        "ss-faq_item-7": { "type": "faq_item", "settings": { "question": "Teklif fiyatlarına KDV dahil mi?", "answer": "<p>KDV ve diğer vergilerin fiyata dahil olup olmadığı teklifte açıkça belirtilir.</p>" } },
        "ss-tab-8": { "type": "tab", "settings": { "tab": "Sipariş ve ödeme" } },
        "ss-faq_item-9": { "type": "faq_item", "settings": { "question": "Bireysel olarak satın alabilir miyim?", "answer": "<p>Sitemiz, ticari faaliyeti kapsamında alım yapan firmalara yönelik satış yapmaktadır.</p>" } },
        "ss-faq_item-10": { "type": "faq_item", "settings": { "question": "Ödeme nasıl yapılır?", "answer": "<p>Ödeme yöntemi ve vadesi teklifte belirtilir. Sipariş, teklifin yazılı olarak onaylanmasıyla kesinleşir.</p>" } },
        "ss-tab-11": { "type": "tab", "settings": { "tab": "Teslimat ve garanti" } },
        "ss-faq_item-12": { "type": "faq_item", "settings": { "question": "Teslimat süresi ne kadar?", "answer": "<p>Teslimat süresi ürünün stok durumuna ve teslimat yerine göre değişir; her teklifte ayrıca belirtilir.</p>" } },
        "ss-faq_item-13": { "type": "faq_item", "settings": { "question": "Ürünler garantili mi?", "answer": "<p>Garanti kapsamı ve süresi ürüne göre değişir ve teklifte belirtilir.</p>" } },
        "ss-faq_item-14": { "type": "faq_item", "settings": { "question": "Ürün hasarlı ulaşırsa ne yapmalıyım?", "answer": "<p>Teslimatta ambalajı kontrol edin; hasar varsa taşıyıcıya hasar tespit tutanağı düzenletin ve aynı gün bize bildirin. Ayrıntılar için <a href=\"/policies/refund-policy\">İade ve Garanti Koşulları</a> sayfasına bakın.</p>" } }
