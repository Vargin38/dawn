{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
{%- comment -%}
  Alternatif ürünler: önce ürünün en dar kategorisinden, yetmezse en geniş kategorisinden en fazla 4 ürün.
  Shopify'ın otomatik önerileri boş döndüğü için öneriler koleksiyonlardan seçilir.
{%- endcomment -%}
{%- liquid
  assign alt = nil
  assign alt_sayi = 100000
  assign ust = nil
  assign ust_sayi = 0
  for c in product.collections
    if c.handle == 'frontpage'
      continue
    endif
    if c.all_products_count < alt_sayi
      assign alt = c
      assign alt_sayi = c.all_products_count
    endif
    if c.all_products_count > ust_sayi
      assign ust = c
      assign ust_sayi = c.all_products_count
    endif
  endfor
  assign limit = section.settings.products_to_show
  assign secilen = '|' | append: product.id | append: '|'
  assign adet = 0
-%}
{%- capture kartlar -%}
  {%- if alt -%}
    {%- for p in alt.products limit: 50 -%}
      {%- assign anahtar = '|' | append: p.id | append: '|' -%}
      {%- unless secilen contains anahtar or adet >= limit -%}
        {%- assign secilen = secilen | append: p.id | append: '|' -%}
        {%- assign adet = adet | plus: 1 -%}
        {%- render 'dg-alternatif-kart', p: p, section_id: section.id -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if ust and adet < limit -%}
    {%- for p in ust.products limit: 50 -%}
      {%- assign anahtar = '|' | append: p.id | append: '|' -%}
      {%- unless secilen contains anahtar or adet >= limit -%}
        {%- assign secilen = secilen | append: p.id | append: '|' -%}
        {%- assign adet = adet | plus: 1 -%}
        {%- render 'dg-alternatif-kart', p: p, section_id: section.id -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if adet > 0 -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {%- assign hedef = alt | default: ust -%}
  <section class="dg-alternatif color-{{ section.settings.color_scheme }}" aria-labelledby="dg-alternatif-{{ section.id }}">
    <div class="dg-sayfa">
      <div class="dg-alternatif__ust">
        <div>
          <p class="dg-kas dg-kas--mavi">{% if dg_en %}Alternative products{% else %}Alternatif ürünler{% endif %}</p>
          <h2 id="dg-alternatif-{{ section.id }}">{{ section.settings.heading }}</h2>
        </div>
        {%- if hedef -%}
          <a class="dg-ok" href="{{ hedef.url }}">{{ hedef.title }}: {% if dg_en %}view all{% else %}tümünü görün{% endif %}{% render 'dg-ikon', ad: 'ok' %}</a>
        {%- endif -%}
      </div>
      <ul class="grid product-grid contains-card--product grid--2-col-tablet-down grid--4-col-desktop" role="list">
        {{ kartlar }}
      </ul>
    </div>
  </section>
  <style>
    .dg-alternatif { padding: 5.6rem 0; }
    .dg-alternatif__ust { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.2rem 3rem; margin-bottom: 2.8rem; }
    .dg-alternatif__ust h2 { margin: .4rem 0 0; }
    .dg-alternatif .dg-stok { display: inline-flex; align-items: center; gap: .6rem; margin: .8rem 0 0; font-family: var(--dg-mono); font-size: 1.15rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
    .dg-alternatif .dg-stok::before { content: ''; width: .8rem; height: .8rem; border-radius: 50%; background: currentColor; }
    .dg-alternatif .dg-stok--var { color: #1F7A3E; }
    .dg-alternatif .dg-stok--teklif { color: var(--dg-etkin); }
    @media (max-width: 749px) { .dg-alternatif { padding: 4rem 0; } }
  </style>
{%- endif -%}
{% schema %}
{
  "name": "Alternatif ürünler",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Aynı kategorideki diğer ürünler" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Ürün sayısı", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ]
}
{% endschema %}
