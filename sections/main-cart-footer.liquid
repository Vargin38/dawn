{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{% if dg_en %}Order note (invoice name, tax office and number, delivery note){% else %}Sipariş notu (fatura unvanı, vergi dairesi ve numarası, teslimat notu){% endif %}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{% if dg_en %}E.g. Invoice: ABC Food Ltd. · Tax office and number{% else %}Örn. Fatura: ABC Gıda Ltd. Şti. · Hocapaşa V.D. 1234567890{% endif %}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks dg-cart-summary-card">
        <div class="dg-cart-summary-head">
          <div>
            <p class="dg-cart-eyebrow">{% if dg_en %}ORDER SUMMARY{% else %}SİPARİŞ ÖZETİ{% endif %}</p>
            <h2>{% if dg_en %}Complete securely{% else %}Güvenli şekilde tamamlayın{% endif %}</h2>
          </div>
          <span class="dg-cart-item-count">{{ cart.item_count }} {% if dg_en %}{% if cart.item_count == 1 %}item{% else %}items{% endif %}{% else %}ürün{% endif %}</span>
        </div>

        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{% render 'dg-money', amount: discount.total_allocated_amount %})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{% if dg_en %}Subtotal (incl. VAT){% else %}Ara toplam (KDV dahil){% endif %}</h2>
                  <p class="totals__total-value">{% render 'dg-money', amount: cart.total_price %}</p>
                </div>

                <small class="tax-note caption-large rte">
                  {% if dg_en %}Prices include VAT. Shipping is paid by the recipient to the carrier on delivery.{% else %}Fiyatlara KDV dahildir. Kargo alıcı ödemelidir; ücreti teslimatta taşıyıcıya ödenir.{% endif %}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <label class="dg-onay" for="DgOnay">
                  <input type="checkbox" id="DgOnay" name="attributes[Ön Bilgilendirme ve Mesafeli Satış Sözleşmesi]" value="Onaylandı" form="cart" required>
                  <span>
                    {% if dg_en %}I have read and accept the{% else %}{% endif %}
                    <a href="{{ pages['on-bilgilendirme-formu'].url | default: '/pages/on-bilgilendirme-formu' }}" target="_blank" rel="noopener">{% if dg_en %}Pre-Contractual Information Form{% else %}Ön Bilgilendirme Formu{% endif %}</a>{% if dg_en %}{% else %}'nu ve{% endif %}
                    {% if dg_en %}and the{% else %}{% endif %}
                    <a href="{{ pages['mesafeli-satis-sozlesmesi'].url | default: '/pages/mesafeli-satis-sozlesmesi' }}" target="_blank" rel="noopener">{% if dg_en %}Distance Sales Agreement{% else %}Mesafeli Satış Sözleşmesi{% endif %}</a>{% if dg_en %}.{% else %}'ni okudum, kabul ediyorum.{% endif %}
                  </span>
                </label>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {% if dg_en %}Proceed to secure checkout{% else %}Güvenli ödemeye geç{% endif %}
                </button>
              </div>
          {%- endcase -%}
        {% endfor %}

        <div class="dg-cart-trust" role="list" aria-label="{% if dg_en %}Order assurances{% else %}Sipariş güven bilgileri{% endif %}">
          <div class="dg-cart-trust__item" role="listitem">
            <span class="dg-cart-trust__icon" aria-hidden="true">✓</span>
            <span><strong>{% if dg_en %}VAT-inclusive prices{% else %}KDV dahil fiyat{% endif %}</strong><small>{% if dg_en %}No extra VAT at checkout{% else %}Ödeme adımında ek KDV yok{% endif %}</small></span>
          </div>
          <div class="dg-cart-trust__item" role="listitem">
            <span class="dg-cart-trust__icon" aria-hidden="true">✓</span>
            <span><strong>{% if dg_en %}Secure Shopify checkout{% else %}Shopify güvenli ödeme{% endif %}</strong><small>{% if dg_en %}Payment details are entered at the secure checkout{% else %}Ödeme bilgileri güvenli checkout'ta alınır{% endif %}</small></span>
          </div>
          <div class="dg-cart-trust__item" role="listitem">
            <span class="dg-cart-trust__icon" aria-hidden="true">↻</span>
            <span><strong>{% if dg_en %}14-day withdrawal for consumers{% else %}Tüketici siparişlerinde 14 gün{% endif %}</strong><small>{% if dg_en %}Statutory exceptions apply; not for business purchases{% else %}Kanuni istisnalar ve ticari alımlar saklıdır{% endif %}</small></span>
          </div>
        </div>

        <div class="dg-cart-help">
          <div>
            <strong>{% if dg_en %}Questions before you order?{% else %}Sipariş öncesi sorunuz mu var?{% endif %}</strong>
            <span>{% if dg_en %}Message us about products, delivery or quotes.{% else %}Ürün, teslimat veya teklif için bize yazın.{% endif %}</span>
          </div>
          <a href="{% if dg_en %}https://wa.me/905418890092?text=Hello%2C%20I%20would%20like%20information%20about%20the%20product%20in%20my%20cart.{% else %}https://wa.me/905418890092?text=Merhaba%2C%20sepetimdeki%20%C3%BCr%C3%BCn%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum.{% endif %}" target="_blank" rel="noopener">{% if dg_en %}Ask on WhatsApp{% else %}WhatsApp'tan danışın{% endif %}</a>
        </div>

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var kutu = document.getElementById('DgOnay');
    var dugme = document.getElementById('checkout');
    if (!kutu || !dugme) return;
    dugme.addEventListener('click', function (e) {
      if (!kutu.checked) {
        e.preventDefault();
        kutu.closest('.dg-onay').classList.add('dg-onay--uyari');
        kutu.focus();
      }
    });
    kutu.addEventListener('change', function () {
      kutu.closest('.dg-onay').classList.remove('dg-onay--uyari');
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "subtotal", "name": "t:sections.main-cart-footer.blocks.subtotal.name", "limit": 1 },
    { "type": "buttons", "name": "t:sections.main-cart-footer.blocks.buttons.name", "limit": 1 },
    { "type": "@app" }
  ]
}
{% endschema %}
