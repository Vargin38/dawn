{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quote-request__product {
    margin: 0 0 2rem;
    padding: 1.2rem 1.6rem;
    border-left: 0.3rem solid rgb(var(--color-button));
    background: rgba(var(--color-foreground), 0.04);
  }

  .quote-request__consent {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin: 2rem 0;
    font-size: 1.4rem;
    line-height: 1.5;
  }

  .quote-request__consent input {
    margin-top: 0.3rem;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    accent-color: rgb(var(--color-button));
  }
{%- endstyle -%}

{%- liquid
  assign form_id = 'QuoteForm-' | append: section.id
  assign has_product = false
  if product != blank
    assign has_product = true
    assign quote_variant = product.selected_or_first_available_variant
  endif
-%}

<div id="teklif-formu" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding dg-teklif">
    <div class="dg-teklif__yan">
      <p class="dg-kas dg-kas--mavi">{% if dg_en %}Quote form{% else %}Teklif formu{% endif %}</p>
      {%- if section.settings.heading != blank -%}
        <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte dg-teklif__metin">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="dg-teklif__kanallar">
        <li><a href="tel:+905418890092">{% render 'dg-ikon', ad: 'tel' %}<span><span class="dg-kas">{% if dg_en %}Phone{% else %}Telefon{% endif %}</span>+90 541 889 00 92</span></a></li>
        <li><a href="https://wa.me/905418890092" target="_blank" rel="noopener">{% render 'dg-ikon', ad: 'wa' %}<span><span class="dg-kas">WhatsApp</span>0541 889 00 92</span></a></li>
        <li><a href="mailto:info@degirmen.com.tr">{% render 'dg-ikon', ad: 'eposta' %}<span><span class="dg-kas">{% if dg_en %}Email{% else %}E-posta{% endif %}</span>info@degirmen.com.tr</span></a></li>
      </ul>
      <p class="dg-teklif__saat">{% render 'dg-ikon', ad: 'saat' %}{% if dg_en %}Weekdays 09:00–18:00 (GMT+3){% else %}Hafta içi 09:00–18:00{% endif %}</p>
    </div>

    <div class="dg-teklif__form">
    {%- form 'contact', id: form_id, class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <h3 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {% if dg_en %}We have received your quote request. We will get back to you by email or phone as soon as possible.{% else %}Teklif talebiniz bize ulaştı. En kısa sürede e-posta veya telefonla size dönüş yapacağız.{% endif %}
        </h3>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h3 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {% if dg_en %}Please check your email address.{% else %}Lütfen e-posta adresinizi kontrol edin.{% endif %}
          </h3>
        </div>
      {%- endif -%}

      {%- if has_product -%}
        <p class="quote-request__product">
          <strong>{% if dg_en %}Product{% else %}Ürün{% endif %}:</strong> {{ product.title | escape }}
          {%- if quote_variant.sku != blank %}<br><strong>{% if dg_en %}SKU{% else %}Stok kodu{% endif %}:</strong> {{ quote_variant.sku | escape }}{% endif %}
        </p>
        <input type="hidden" name="contact[Ürün]" value="{{ product.title | escape }}">
        <input type="hidden" name="contact[Stok kodu]" value="{{ quote_variant.sku | escape }}">
        <input type="hidden" name="contact[Ürün bağlantısı]" value="{{ shop.url }}{{ product.url }}">
      {%- endif -%}
      <input type="hidden" name="contact[tags]" value="teklif-talebi">
      {%- if dg_en %}
      <input type="hidden" name="contact[Dil]" value="English">
      {%- endif %}

      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="{{ form_id }}-name"
            name="contact[Ad Soyad]"
            placeholder="{% if dg_en %}Full name{% else %}Ad Soyad{% endif %}"
            required
          >
          <label class="field__label" for="{{ form_id }}-name">{% if dg_en %}Full name{% else %}Ad Soyad{% endif %} <span aria-hidden="true">*</span></label>
        </div>
        <div class="field">
          <input
            class="field__input"
            autocomplete="organization"
            type="text"
            id="{{ form_id }}-company"
            name="contact[Firma]"
            placeholder="{% if dg_en %}Company name{% else %}Firma adı{% endif %}"
            required
          >
          <label class="field__label" for="{{ form_id }}-company">{% if dg_en %}Company name{% else %}Firma adı{% endif %} <span aria-hidden="true">*</span></label>
        </div>
      </div>
      <div class="contact__fields">
        <div class="field field--with-error">
          <input
            class="field__input"
            autocomplete="email"
            type="email"
            id="{{ form_id }}-email"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            placeholder="{% if dg_en %}Email{% else %}E-posta{% endif %}"
            aria-required="true"
            required
          >
          <label class="field__label" for="{{ form_id }}-email">{% if dg_en %}Email{% else %}E-posta{% endif %} <span aria-hidden="true">*</span></label>
        </div>
        <div class="field">
          <input
            class="field__input"
            autocomplete="tel"
            type="tel"
            id="{{ form_id }}-phone"
            name="contact[Telefon]"
            placeholder="{% if dg_en %}Phone{% else %}Telefon{% endif %}"
            required
          >
          <label class="field__label" for="{{ form_id }}-phone">{% if dg_en %}Phone{% else %}Telefon{% endif %} <span aria-hidden="true">*</span></label>
        </div>
      </div>
      {%- if has_product -%}
        <div class="field">
          <input
            class="field__input"
            type="number"
            min="1"
            step="1"
            id="{{ form_id }}-quantity"
            name="contact[Adet]"
            placeholder="{% if dg_en %}Quantity{% else %}Adet{% endif %}"
            value="1"
          >
          <label class="field__label" for="{{ form_id }}-quantity">{% if dg_en %}Quantity{% else %}Adet{% endif %}</label>
        </div>
      {%- endif -%}
      <div class="field">
        <textarea
          rows="6"
          id="{{ form_id }}-body"
          class="text-area field__input"
          name="contact[body]"
          placeholder="{% if dg_en %}Your request{% else %}Talebiniz{% endif %}"
        ></textarea>
        <label class="form__label field__label" for="{{ form_id }}-body">
          {% if dg_en %}Your request (intended use, delivery city and country, special requirements){% else %}Talebiniz (kullanım amacı, teslimat şehri, özel istekler){% endif %}
        </label>
      </div>

      <label class="quote-request__consent" for="{{ form_id }}-consent">
        <input type="checkbox" id="{{ form_id }}-consent" name="contact[KVKK onayı]" value="Okudum" required>
{%- if dg_en %}
        <span>
          I have read the
          {% if shop.privacy_policy %}
            <a href="{{ shop.privacy_policy.url }}" class="link" target="_blank">Privacy Notice (KVKK)</a>
          {% else %}
            Privacy Notice (KVKK)
          {% endif %}
          on the processing of my personal data to answer my quote request. <span aria-hidden="true">*</span>
        </span>
        {%- else %}
        <span>
          Kişisel verilerimin teklif talebimin yanıtlanması amacıyla işlenmesine ilişkin
          {% if shop.privacy_policy %}
            <a href="{{ shop.privacy_policy.url }}" class="link" target="_blank">KVKK Aydınlatma Metni</a>'ni
          {% else %}
            KVKK Aydınlatma Metni'ni
          {% endif %}
          okudum. <span aria-hidden="true">*</span>
        </span>
        {%- endif %}
      </label>

      <div class="contact__button">
        <button type="submit" class="button">
          {%- if dg_en %}{{ section.settings.button_label | default: 'Request a quote' | escape }}{% else %}{{ section.settings.button_label | default: 'Teklif İste' | escape }}{% endif -%}
        </button>
      </div>
    {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Teklif formu",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Bu ürün için teklif isteyin", "label": "Başlık" },
    { "type": "select", "id": "heading_size", "options": [ { "value": "h2", "label": "Küçük" }, { "value": "h1", "label": "Orta" }, { "value": "h0", "label": "Büyük" } ], "default": "h1", "label": "Başlık boyutu" },
    { "type": "richtext", "id": "text", "default": "<p>Formu doldurun, firmanıza özel fiyat ve teslimat bilgisini içeren teklifimizi e-posta ile iletelim.</p>", "label": "Açıklama" },
    { "type": "text", "id": "button_label", "default": "Teklif İste", "label": "Buton metni" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Üst boşluk", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Alt boşluk", "default": 36 }
  ],
  "presets": [ { "name": "Teklif formu" } ]
}
{% endschema %}