{%- comment -%}
  dg-katalog'un markaya göre süzülen sürümü: yalnızca seçilen koleksiyondaki ve (doluysa) seçilen markadaki
  ürünlerin üretici kataloglarını listeler. Görünüm dg-katalog sınıflarını (assets/dg-bolumler.css) kullanır.
{%- endcomment -%}
{%- liquid
  assign kaynak = section.settings.koleksiyon
  if kaynak == blank
    assign kaynak = collections.all
  endif
  assign marka = section.settings.marka | strip | downcase
  assign sayac = 0
-%}
{%- capture satirlar -%}
  {%- assign urunler = kaynak.products | sort: 'title' -%}
  {%- for p in urunler -%}
    {%- assign p_marka = p.vendor | strip | downcase -%}
    {%- if sayac < section.settings.adet and p.description contains 'class="urun-katalog"' -%}
      {%- if marka == blank or p_marka == marka -%}
        {%- liquid
          assign kutu = p.description | split: 'class="urun-katalog"' | last
          assign yol = kutu | split: 'href="https://cdn.shopify.com' | last | split: '"' | first
          assign pdf = 'https://cdn.shopify.com' | append: yol
          assign paragraflar = kutu | split: '<p>'
          assign dokuman = paragraflar[1] | split: ' (PDF' | first | strip_html | strip
          assign boyut = paragraflar[1] | split: '(PDF, ' | last | split: ')' | first | strip_html | strip
          assign sayac = sayac | plus: 1
        -%}
        <div class="dg-katalog__satir" role="row">
          <span role="cell" class="dg-kas dg-kas--mavi">{{ p.vendor }}</span>
          <span role="cell"><a href="{{ p.url }}">{{ p.title }}</a></span>
          <span role="cell" class="dg-katalog__dokuman">{{ dokuman }}</span>
          <span role="cell"><a class="dg-katalog__indir" href="{{ pdf }}" target="_blank" rel="noopener" aria-label="{{ dokuman | escape }} — {{ section.settings.indir_etiket | escape }}">{% render 'dg-ikon', ad: 'indir' %}<span>{{ section.settings.pdf_etiket }} · {{ boyut }}</span></a></span>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if sayac > 0 -%}
<section class="dg-katalog dg-marka-katalog" aria-labelledby="dg-marka-katalog-{{ section.id }}">
  <div class="dg-sayfa">
    <div class="dg-katalog__ust">
      <div class="dg-baslik-blok">
        <p class="dg-kas dg-kas--mavi">{{ section.settings.kas }}</p>
        <h2 id="dg-marka-katalog-{{ section.id }}">{{ section.settings.baslik }}</h2>
        {%- if section.settings.metin != blank -%}<p>{{ section.settings.metin }}</p>{%- endif -%}
      </div>
    </div>
    <div class="dg-katalog__tablo" role="table" aria-label="{{ section.settings.baslik | escape }}">
      <div class="dg-katalog__satir dg-katalog__satir--baslik" role="row">
        <span role="columnheader">{{ section.settings.kolon_marka }}</span>
        <span role="columnheader">{{ section.settings.kolon_urun }}</span>
        <span role="columnheader">{{ section.settings.kolon_dokuman }}</span>
        <span role="columnheader"><span class="visually-hidden">{{ section.settings.indir_etiket }}</span></span>
      </div>
      {{ satirlar }}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Marka katalogları",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "koleksiyon", "label": "Koleksiyon (boşsa tüm ürünler)" },
    { "type": "text", "id": "marka", "label": "Marka (ürün satıcısı; boşsa tüm markalar)" },
    { "type": "text", "id": "kas", "label": "Üst etiket", "default": "Teknik dokümanlar" },
    { "type": "text", "id": "baslik", "label": "Başlık", "default": "Katalog ve veri sayfaları" },
    { "type": "textarea", "id": "metin", "label": "Açıklama" },
    { "type": "range", "id": "adet", "label": "Gösterilecek doküman", "min": 3, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "kolon_marka", "label": "Sütun: marka", "default": "Marka" },
    { "type": "text", "id": "kolon_urun", "label": "Sütun: ürün", "default": "Ürün" },
    { "type": "text", "id": "kolon_dokuman", "label": "Sütun: doküman", "default": "Doküman" },
    { "type": "text", "id": "pdf_etiket", "label": "Dosya türü etiketi", "default": "PDF" },
    { "type": "text", "id": "indir_etiket", "label": "İndirme bağlantısı (ekran okuyucu)", "default": "PDF indir" }
  ],
  "presets": [{ "name": "Marka katalogları" }]
}
{% endschema %}
