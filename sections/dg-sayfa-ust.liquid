{%- liquid
  assign dg_en = false
  if request.locale.iso_code == 'en'
    assign dg_en = true
  endif
-%}
<section class="dg-kol-ust dg-sayfa-ust">
  <div class="dg-sayfa">
    <nav class="dg-yol" aria-label="{% if dg_en %}Breadcrumb{% else %}Sayfa yolu{% endif %}">
      <a href="{{ routes.root_url }}">{% if dg_en %}Home{% else %}Ana sayfa{% endif %}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>
    <p class="dg-kas">{{ section.settings.kas }}</p>
    <h1 class="dg-kol-ust__baslik">{{ page.title }}</h1>
    {%- if section.settings.metin != blank -%}
      <div class="dg-kol-ust__metin"><p>{{ section.settings.metin }}</p></div>
    {%- endif -%}
  </div>
  <span class="dg-cetvel dg-kol-ust__cetvel" aria-hidden="true"></span>
</section>
{% schema %}
{
  "name": "Sayfa başlığı",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kas", "label": "Üst etiket", "default": "Kurumsal" },
    { "type": "textarea", "id": "metin", "label": "Kısa açıklama" }
  ],
  "presets": [{ "name": "Sayfa başlığı" }]
}
{% endschema %}